# Banco de Dados existente (MariaDB / MySQL compartilhado)
DATABASE_URL=mysql+pymysql://usuario:senha@host:3306/nome_do_banco

# JWT — chave compartilhada para assinatura e validação dos tokens
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=chave_secreta_jwt_longa_e_segura
ALGORITHM=HS256
# 2 h, sem refresh token até 13/11 (docs/adr/005). Na stack, remova o valor antigo de 1440.
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Portas e Comunicação entre Serviços
PORT=8000
AUTH_SERVICE_URL=http://auth-service:8001

# ── E-mail (SMTP Mailtrap) ────────────────────────────────────────────────────
# DESENVOLVIMENTO — Mailtrap Sandbox: captura os e-mails numa caixa de testes,
# NÃO entrega ao destinatário real.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=seu_usuario_mailtrap
MAILTRAP_PASSWORD=sua_senha_mailtrap
#
# PRODUÇÃO — Mailtrap Email Sending: entrega ao e-mail real do usuário.
# Exige domínio verificado no Mailtrap (SPF/DKIM). Troque as linhas acima por:
# MAILTRAP_HOST=live.smtp.mailtrap.io
# MAILTRAP_PORT=587
# MAILTRAP_USERNAME=apismtp@mailtrap.io   (conforme exibido no painel do domínio)
# MAILTRAP_PASSWORD=token_de_api_do_mailtrap
#
# O remetente precisa pertencer ao domínio verificado (em produção).
MAILTRAP_FROM_EMAIL=nao-responda@nivelo.app
MAILTRAP_FROM_NAME=Nivelo

# URL PÚBLICA da aplicação (com HTTPS em produção) — usada no link do e-mail
# e como base dos links do Grafana (CATALOGO_URL/grafana/)
CATALOGO_URL=http://localhost:8000

# Redefinição de senha
RESET_TOKEN_EXPIRE_MINUTES=30
# Máximo de solicitações por usuário dentro da janela (anti-abuso)
RESET_REQUEST_LIMIT=3
RESET_REQUEST_WINDOW_MINUTES=15
# Somente dev: sem credenciais SMTP, registra o link no log do auth-service
# em vez de falhar. Mantenha false em produção.
EMAIL_LOG_LINK_WITHOUT_SMTP=false

# ── Auditoria (log-service) ───────────────────────────────────────────────────
# Token compartilhado entre a API e o log-service. Gere com: openssl rand -hex 32
LOG_INTERNAL_TOKEN=token_interno_do_log_service

# ── Observabilidade (Prometheus + Grafana) ────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=senha_do_admin_do_grafana
# Em produção, Grafana e Prometheus não publicam porta no host: acesse por
# CATALOGO_URL/grafana e CATALOGO_URL/prometheus. GRAFANA_PORT/PROMETHEUS_PORT
# só valem no docker-compose.dev.yml (se as portas padrão estiverem ocupadas):
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
#
# Senha do proxy /prometheus exposto pelo catalogo (usuário fixo "admin" no HTTP Basic).
# O Prometheus não tem login próprio — sem essa variável, o proxy fica desabilitado (503).
# Gere com: openssl rand -hex 16
PROMETHEUS_PROXY_PASSWORD=senha_do_proxy_do_prometheus

# ── Object storage (Garage) — Atividade 6 ─────────────────────────────────────
# GARAGE_RPC_SECRET:  openssl rand -hex 32
# STORAGE_ACCESS_KEY: echo "GK$(openssl rand -hex 16)"   (precisa começar com GK)
# STORAGE_SECRET_KEY: openssl rand -hex 32
GARAGE_RPC_SECRET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=catalogo-avatares
# Expiração da URL pré-assinada (ver README)
STORAGE_BANDA_MINIMA_KBPS=256
STORAGE_MARGEM_USO_SEGUNDOS=600
STORAGE_EXPIRACAO_MAX_SEGUNDOS=3600
# Tamanho máximo do upload da foto (2 MB)
PERFIL_FOTO_MAX_BYTES=2097152

# ── Plano Premium (Stripe, SOMENTE modo de teste) — Atividade 7 ───────────────
# Painel do Stripe com "Test mode" ligado → Developers → API keys. Chave sk_live_ é recusada.
STRIPE_SECRET_KEY=sk_test_xxx
# Impresso pela Stripe CLI ao subir ("Ready! Your webhook signing secret is whsec_...").
# É DIFERENTE do segredo de um endpoint cadastrado no painel — não misture.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Preço recorrente mensal do produto "Plano Premium" (R$ 9,90/mês)
STRIPE_PRICE_ID=price_xxx
# Para onde o Stripe devolve o usuário (/premium/sucesso e /premium/cancelado).
# A SPA é servida pela própria API; use http://localhost:4200 se rodar o ng serve.
FRONTEND_URL=http://localhost:8000
# Token compartilhado entre a API e o auth-service (rota interna que grava o premium).
# Gere com: openssl rand -hex 32
AUTH_INTERNAL_TOKEN=token_interno_do_auth_service

# ── Imagens (GHCR) ────────────────────────────────────────────────────────────
# latest por padrão; use sha-<commit> para fixar uma versão publicada pelo CI
# IMAGE_TAG=latest

# ── Seed de desenvolvimento ───────────────────────────────────────────────────
# true aplica db/900_seed_dev.sql no boot da API (só em desenvolvimento; padrão false)
SEED=
# Ambiente: production na stack (o seed se recusa a rodar e o boot falha se SEED=true)
APP_ENV=
